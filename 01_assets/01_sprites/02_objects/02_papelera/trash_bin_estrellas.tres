code = "shader_type canvas_item;
render_mode blend_mix;



// RotateUVAnimated
#include \"res://addons/shaderV/uv/animated/rotateAnimated.gdshaderinc\"
// GenericNoise2D
#include \"res://addons/shaderV/rgba/noise/generic2d.gdshaderinc\"

void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(TEXTURE, UV);
	float n_out3p4 = n_out3p0.a;


// Input:7
	float n_out7p0 = TIME;


	vec3 n_out6p0;
// RotateUVAnimated:6
	float n_in6p1 = -0.20000;
	vec3 n_in6p2 = vec3(0.50000, 0.50000, 0.00000);
	{
		n_out6p0 = vec3(_rotateUVAnimatedFunc(UV.xy, n_in6p2.xy, 0.0, n_in6p1, n_out7p0), 0);
	}


	float n_out5p0;
// GenericNoise2D:5
	vec3 n_in5p1 = vec3(0.00000, 0.00000, 0.00000);
	float n_in5p2 = 50.00000;
	{
		n_out5p0 = _genericNoise2D((n_out6p0.xy + n_in5p1.xy) * n_in5p2);
	}


// Compare:9
	float n_in9p1 = 0.60000;
	bool n_out9p0 = n_out5p0 > n_in9p1;


// FloatOp:10
	float n_out10p0 = n_out3p4 * (n_out9p0 ? 1.0 : 0.0);


// Output:0
	COLOR.rgb = vec3(n_out3p0.xyz);
	COLOR.a = n_out10p0;


}
